# Voyara Backend Environment Variables (Production & Local Development)
PROJECT_NAME="Voyara"
PROJECT_SLOGAN="Find Your Place."
PROJECT_BRAND="Stay. Explore. Adventure."
ENVIRONMENT=development
API_V1_STR=/api

# Database Configuration
# Local Development: postgresql+psycopg://postgres:your_local_password@localhost:5432/voyara
# Render Production: Set by Render Environment Variable (e.g. postgresql://user:pass@host/db)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/voyara

# JWT & Security (Rotate and use a strong random secret in production)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","https://voyara-delta.vercel.app","https://voyara.vercel.app"]

# Frontend Base URL
FRONTEND_URL=https://voyara-delta.vercel.app

# Google OAuth 2.0 (Google Identity Services Client ID)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Razorpay Payment Gateway (Test or Live credentials)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# SMTP Email Configuration (Gmail App Password / SendGrid / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
EMAILS_FROM_NAME="Voyara"
EMAILS_FROM_EMAIL="no-reply@voyara.com"

# OTP & SMS Provider Configuration
# Set OTP_PROVIDER=development for local testing (Uses fixed OTP 123456 without consuming credits)
# Set OTP_PROVIDER=2factor for live production carrier SMS delivery
OTP_PROVIDER=development
TWOFACTOR_API_KEY=your_2factor_api_key_here

# Alternative SMS Providers (Optional fallbacks)
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MSG91_AUTH_KEY=
TEXTLOCAL_API_KEY=
